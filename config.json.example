{
  "pollIntervalSec": 15,
  "maxConcurrent": 4,
  "notify": true,
  "warnLatencyMs": 1500,
  "compact": false,
  "services": [
    { "name": "Nextcloud", "url": "https://cloud.local", "type": "http", "group": "Apps" },
    { "name": "Jellyfin", "url": "http://10.0.0.6:8096/health", "type": "http", "group": "Apps" },
    { "name": "Grafana", "url": "http://10.0.0.7:3000", "type": "http", "group": "Apps" },
    { "name": "Proxmox", "host": "10.0.0.5", "port": 8006, "type": "tcp", "group": "Infra" },
    { "name": "Pi-hole", "host": "10.0.0.8", "port": 53, "type": "tcp", "group": "Infra", "intervalSec": 60 },
    { "name": "Immich (container)", "host": "user@10.0.0.5", "container": "immich_server", "type": "docker", "group": "Infra" }
  ]
}
